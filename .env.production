# Frontend (Vite) PRODUCTION environment — committed, no secrets.
# Loaded automatically by `vite build` (production mode) and baked into the
# static bundle deployed to GitHub Pages. The deployed site calls the FastAPI
# backend on Render directly (no dev proxy exists in production).
#
# This is a public URL — it ships in the client JS anyway — so it is safe to commit.
VITE_API_BASE_URL=https://careatlas.onrender.com/api
