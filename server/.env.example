# ServiceNow instance hostname (no https://, just the host)
SNOW_INSTANCE=ven04690.service-now.com

# ServiceNow service account with read access to the AI Control Tower tables
SNOW_USERNAME=your_username_here
SNOW_PASSWORD=your_password_here

# UC1 Privacy — non-human AI agent identity used to prove field-level PII denial.
# Create a sys_user with a role granting u_patient table read (e.g. u_patients_user)
# but WITHOUT role_patient_pii, so PII fields are stripped from its reads. Used by
# GET /governance/privacy-controls to live-probe the field-level ACL deny.
SNOW_PII_AGENT_USERNAME=svc-careatlas-agent
SNOW_PII_AGENT_PASSWORD=your_agent_password_here

# UC1 Privacy — privileged counterpart agent that DOES hold role_patient_pii (plus
# u_patient table read). Drives the "authorized" side of the role-based redaction demo.
SNOW_CLINICAL_AGENT_USERNAME=svc-clinical-agent
SNOW_CLINICAL_AGENT_PASSWORD=your_clinical_agent_password_here

# OAuth client credentials for Zurich A2A agent execution.
# Configure these in ServiceNow and enable the A2A auth scope for the client.
SNOW_A2A_CLIENT_ID=your_a2a_client_id_here
SNOW_A2A_CLIENT_SECRET=your_a2a_client_secret_here
# SNOW_A2A_TOKEN_SKEW_SECONDS=60

# Public callback endpoint ServiceNow can reach for asynchronous A2A results.
A2A_CALLBACK_BASE_URL=https://careatlas.onrender.com
A2A_CALLBACK_TOKEN=choose-a-long-random-token

# AWS Cognito email/password + TOTP MFA auth (mounted under /api/aws).
# COGNITO_CLIENT_SECRET is a secret — keep it out of any frontend bundle.
# AWS credentials for the cognito-idp client come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, shared config, or IAM role).
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your_app_client_id_here
COGNITO_CLIENT_SECRET=your_app_client_secret_here

# Browser origins allowed to call this API (comma-separated). The Vite dev server
# runs on 5173; add your deployed frontend origin here for production.
CORS_ORIGINS=http://localhost:5173,https://gauthiii.github.io

# Only return agents created on or after this ServiceNow (UTC) datetime.
# AGENTS_CREATED_SINCE=2026-06-02 00:00:00

# Microsoft Entra External ID Native Authentication public client settings.
# These are not client secrets. The subdomain is the prefix in:
# https://<subdomain>.ciamlogin.com/common
ENTRA_APP_ID=your_application_client_id_here
ENTRA_TENANT_ID=your_directory_tenant_id_here
ENTRA_OBJECT_ID=your_app_object_id_here
ENTRA_TENANT_SUBDOMAIN=your_external_tenant_subdomain_here

ENTRA_APP_SECRET_VALUE=your_application_client_secret_value_here
ENTRA_APP_SECRET_ID=your_application_client_secret_id_here

# Optional. Defaults to <ENTRA_TENANT_SUBDOMAIN>.onmicrosoft.com when omitted.
# ENTRA_TENANT_DOMAIN=your_external_tenant_subdomain.onmicrosoft.com

# Request offline_access only if you want refresh tokens returned.
ENTRA_SCOPES=openid offline_access profile
