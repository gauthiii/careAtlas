# Frontend (Vite) environment.
# Backend / ServiceNow secrets now live in server/.env — see server/.env.example.

# Base URL the frontend uses for API calls. Defaults to "/api" (proxied to the
# backend in dev). Set to the deployed API origin for a production static build,
# e.g. https://api.example.com/api
# VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api requests. Defaults to the local backend.
# VITE_API_PROXY_TARGET=http://localhost:8000
