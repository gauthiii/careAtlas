# Frontend (Vite) environment.
# Backend / ServiceNow / Entra secrets live in server/.env — see server/.env.example.
#
# There are two env files in play:
#
#   .env             -> LOCAL DEV (gitignored). Copy this file to .env to start.
#   .env.production  -> PRODUCTION (committed). Read by `vite build` for the
#                       GitHub Pages deploy; holds the deployed API origin.

# Base URL the frontend uses for API calls. In dev leave as "/api" so requests go
# through the Vite proxy (same-origin, no CORS). In production this is set in
# .env.production to the deployed API origin, e.g. https://careatlas.onrender.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api requests. Use http://localhost:8000 when
# running the backend locally, or the deployed origin (e.g. https://careatlas.onrender.com)
# to develop against the live backend without running Python.
VITE_API_PROXY_TARGET=http://localhost:8000
